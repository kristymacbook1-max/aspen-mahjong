# Required: Anthropic API key for Claude-powered analysis
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Alpha Vantage API key for news sentiment data
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Optional: Claude model override (default: claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional: Use static template writer instead of LLM (saves API credits)
USE_STATIC_WRITER=false

# Optional: CORS origins for the API server (comma-separated)
CORS_ORIGINS=*
